# ==========================================================================
# TeRed / RATE —— 数据缓存与派生产物
# --------------------------------------------------------------------------
# cache/ 是 DARPA TC E5 与 StreamSpot 的解析结果与归约产物（约 849 MB，
# 单个 parsed JSONL 最大 290 MB）。它们全部可由公开原始数据 + 本仓库脚本
# 重新生成，且单文件超过 GitHub 的 100 MB 上限，因此不入库。
# 复现方式见 README：先跑 scripts/ 下的解析与模板挖掘脚本重建 cache/。
# ==========================================================================
cache/

# 原始数据集（DARPA TC E5 cadets / StreamSpot），体积大且需自行下载
dataset/

# 任何位置的原始图数据（兜底）
*.jsonl

# ==========================================================================
# Python 运行产物
# ==========================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ==========================================================================
# 本地中间/临时文件
# ==========================================================================
results/v3_tmp/
results/v3_tmp2/
results/v3b_control/
*.tmp
*.bak
*.bak.*
*.orig
*~

# 训练权重（体积大，按需另行发布）
*.pth
*.pt
*.ckpt
*.onnx

# 系统框图预览依赖的离线 Mermaid 库（约 3.3 MB，可从 CDN 重新下载）
系统框图/mermaid.min.js

# ==========================================================================
# 编辑器 / 操作系统
# ==========================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 临时结果工作目录（E1/E2/E3/E4s 汇总，可重建）
results/work/
