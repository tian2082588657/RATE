# 统一按文本处理，仓库内一律存 LF，避免 Windows 克隆后 shell 脚本报错
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.csv  text eol=lf
*.txt  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf

# 以下类型不做行尾转换
*.png  binary
*.jpg  binary
*.pdf  binary
*.pth  binary
*.pt   binary
*.jsonl binary
